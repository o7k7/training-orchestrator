REDIS_PASSWORD=securepassword
REDIS_HOST=localhost
ENVIRONMENT=local
ML_FLOW_URI=http://mlflow-prod-service:80

# Only set for a non-AWS S3-compatible endpoint (e.g. local SeaweedFS/MinIO).
# Leave unset on EKS, where the training job's ServiceAccount uses IRSA instead.
S3_ENDPOINT=http://seaweedfs-s3:8333
AWS_KEY=admin
AWS_SECRET=somepassword

API_KEY=change-me
K8S_NAMESPACE=default
TRAINING_JOB_SERVICE_ACCOUNT=default
DEFAULT_JOB_DEADLINE_SECONDS=21600
ZOMBIE_JOB_MAX_AGE_SECONDS=86400